# ContextMesh runtime
CONTEXTMESH_DATA_DIR=./contextmesh-data
CONTEXTMESH_BLOCK_BACKEND=sqlite

# Provider examples — keep secrets out of git
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=

# Durable runtime / queue
CONTEXTMESH_DATA=.contextmesh
CONTEXTMESH_EMBEDDED_WORKER=1

# Resumable upload transport
CONTEXTMESH_UPLOAD_BACKEND=local
# Set backend=s3 to use AWS S3 or MinIO-compatible multipart uploads.
CONTEXTMESH_S3_BUCKET=
CONTEXTMESH_S3_ENDPOINT_URL=
CONTEXTMESH_S3_REGION=
CONTEXTMESH_S3_PREFIX=contextmesh/uploads
