+func TestContextMeshD24SeparatesContextAndOutputBudgets(t *testing.T) {
+	t.Run("generation cap is independent of large context window", func(t *testing.T) {
+		requested := 50000
+		cfg := &modelModule.ChatConfig{MaxTokens: &requested}
+		adjusted, ok, err := clampChatConfigBudgets(cfg, 128000, 16384, 20000)
+		if err != nil {
+			t.Fatalf("clampChatConfigBudgets returned error: %v", err)
+		}
+		if !ok || adjusted != 16384 {
+			t.Fatalf("adjusted=%d ok=%t, want 16384,true", adjusted, ok)
+		}
+	})
+
+	t.Run("remaining context can be tighter than generation cap", func(t *testing.T) {
+		requested := 16000
+		cfg := &modelModule.ChatConfig{MaxTokens: &requested}
+		adjusted, ok, err := clampChatConfigBudgets(cfg, 128000, 16384, 120000)
+		if err != nil {
+			t.Fatalf("clampChatConfigBudgets returned error: %v", err)
+		}
+		if !ok || adjusted != 8000 {
+			t.Fatalf("adjusted=%d ok=%t, want 8000,true", adjusted, ok)
+		}
+	})
+
+	t.Run("context exhaustion fails even when output cap remains", func(t *testing.T) {
+		requested := 1000
+		cfg := &modelModule.ChatConfig{MaxTokens: &requested}
+		if adjusted, ok, err := clampChatConfigBudgets(cfg, 128000, 16384, 128000); err == nil {
+			t.Fatalf("expected context-capacity error, got adjusted=%d ok=%t", adjusted, ok)
+		}
+	})
+}
